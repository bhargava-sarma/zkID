{
  "name": "zkid-contracts",
  "version": "1.0.0",
  "description": "zkID Groth16 verifier contracts (Ethereum Sepolia)",
  "scripts": {
    "compile": "hardhat compile",
    "deploy:all": "npm run deploy:age && npm run deploy:name && npm run deploy:gender && npm run deploy:credential",
    "deploy:age": "hardhat deploy-verifier --contract AgeVerifier --network sepolia",
    "deploy:name": "hardhat deploy-verifier --contract NameVerifier --network sepolia",
    "deploy:gender": "hardhat deploy-verifier --contract GenderVerifier --network sepolia",
    "deploy:credential": "hardhat deploy-verifier --contract CredentialAgeVerifier --network sepolia",
    "verify": "hardhat verify-verifiers --network sepolia"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^3.0.0",
    "hardhat": "^2.19.0"
  },
  "dependencies": {
    "dotenv": "^16.3.1"
  }
}
