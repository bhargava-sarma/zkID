{
  "name": "zkid-contracts",
  "version": "1.0.0",
  "description": "zkID Groth16 verifier contracts (Ethereum Sepolia)",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:all": "npm run deploy:credential && npm run deploy:match && npm run deploy:policy",
    "deploy:credential": "hardhat deploy-verifier --contract CredentialAgeVerifier --network sepolia",
    "deploy:match": "hardhat deploy-verifier --contract CredentialMatchVerifier --network sepolia",
    "deploy:policy": "hardhat deploy-policy --network sepolia",
    "verify": "hardhat verify-verifiers --network sepolia"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^3.0.0",
    "hardhat": "^2.19.0"
  },
  "dependencies": {
    "dotenv": "^16.3.1"
  }
}
