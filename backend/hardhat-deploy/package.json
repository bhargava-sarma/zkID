{
  "name": "zkid-contracts",
  "version": "1.0.0",
  "description": "zkID Groth16 verifier contracts (Polygon Amoy)",
  "scripts": {
    "compile": "hardhat compile",
    "deploy:age": "hardhat deploy-verifier --contract AgeVerifier --network amoy",
    "deploy:name": "hardhat deploy-verifier --contract NameVerifier --network amoy",
    "deploy:gender": "hardhat deploy-verifier --contract GenderVerifier --network amoy",
    "deploy:credential": "hardhat deploy-verifier --contract CredentialAgeVerifier --network amoy"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^3.0.0",
    "hardhat": "^2.19.0"
  },
  "dependencies": {
    "dotenv": "^16.3.1"
  }
}
