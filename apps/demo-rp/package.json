{
  "name": "@zkid/demo-rp",
  "private": true,
  "description": "Demo relying party: an age-gated page that uses the zkID verifier SDK end to end. Runs locally; state is in memory.",
  "type": "module",
  "scripts": {
    "setup": "node setup-demo.mjs",
    "start": "node server.ts --port 4101 --demo",
    "start:b": "node server.ts --port 4102 --demo",
    "test:e2e": "node --test --test-concurrency=1 \"e2e/*.test.ts\"",
    "typecheck": "tsc -p ."
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "jsqr": "1.4.0",
    "pngjs": "7.0.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "qrcode": "1.5.4"
  }
}
