{
  "name": "@zkid/demo-rp",
  "private": true,
  "description": "Demo relying party: an age-gated page that uses the zkID verifier SDK end to end, for Aadhaar QRs and DigiLocker PAN records, locally (state in memory) or hosted on Vercel (state in Upstash Redis).",
  "type": "module",
  "scripts": {
    "setup": "node setup-demo.mjs",
    "start": "node server.ts --port 4101 --demo",
    "start:b": "node server.ts --port 4102 --demo",
    "test:e2e": "node --test --test-concurrency=1 \"e2e/*.test.ts\"",
    "typecheck": "tsc -p ."
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@vercel/nft": "1.11.0",
    "jsqr": "1.4.0",
    "playwright": "1.56.1",
    "pngjs": "7.0.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@aztec/bb.js": "5.3.0",
    "@xmldom/xmldom": "0.9.12",
    "@zkpassport/poseidon2": "0.6.2",
    "poseidon-lite": "0.3.0",
    "qrcode": "1.5.4",
    "snarkjs": "0.7.6"
  }
}
