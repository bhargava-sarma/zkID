# Copy to .env.local (gitignored by Vite convention) to override defaults.
# Only VITE_-prefixed variables are exposed to client code.

# Polygon Amoy JSON-RPC endpoint for read-only on-chain proof verification.
#
# Optional. Defaults to https://polygon-amoy-bor-rpc.publicnode.com
#
# Set this if the default endpoint becomes unavailable. The previous default,
# https://rpc-amoy.polygon.technology, stopped resolving entirely (NXDOMAIN),
# which surfaced in the browser as "TypeError: Failed to fetch".
#
# Any Amoy (chainId 80002) endpoint works, but it MUST be CORS-enabled, since
# this call is made from browser JavaScript. An endpoint that responds to curl
# can still be blocked by the browser. Check with:
#
#   curl -i -X OPTIONS <url> -H 'Origin: http://localhost:5173' \
#        -H 'Access-Control-Request-Method: POST'
#
# and confirm an access-control-allow-origin header comes back.
VITE_AMOY_RPC_URL=
