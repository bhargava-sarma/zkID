# Copy to .env and fill in your own values.
# Both the backend server and db.js read this file from the repo root.

# Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# Supabase SERVICE ROLE key (Dashboard > Project Settings > API > service_role).
#
# Required. Row Level Security is enabled on the `users` table with no policies,
# so the anon key is refused on insert with:
#   code 42501: new row violates row-level security policy for table "users"
# The service role key bypasses RLS.
#
# SECRET. Never expose this to a browser. It is safe here only because the
# frontend has no Supabase client - all DB traffic goes browser -> backend ->
# Supabase. If you ever add a Supabase client to frontend/, do NOT reuse this key.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase anon/public key.
#
# INTENTIONALLY UNUSED as of the service-role switch. Kept documented rather than
# deleted so it is clear this is a deliberate choice, not an oversight: writes
# used to go through this key and stopped working when RLS was enabled. Leave it
# blank unless you add a code path that genuinely should be RLS-restricted.
# SUPABASE_ANON_KEY=

# Port the backend Express server listens on
PORT=3001
