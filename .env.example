# Copy to .env (read by the backend from the repo root).

SUPABASE_URL=

# Service role key (Dashboard > Project Settings > API > service_role).
# Required: RLS on `users` has no policies, so the anon key is refused.
# Server-only secret. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

PORT=3001

# Tesseract languages for OCR. Default eng+hin; add scripts as needed, e.g. eng+hin+tam.
# OCR_LANGS=eng+hin
