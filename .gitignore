# Secrets
.env
.env.local
.env.*.local
.env.hardhat
!.env.example

# Key material is never committed. Test keys are generated in memory by the
# tests; see SECURITY_NOTES.md.
*.pem
*.key
*.p12
*.pfx

# Real or sample Secure QR codes hold personal data: local only, never committed.
# The old spike path stays ignored: clones from before the move keep their real
# QR files there (git does not move ignored files).
packages/secure-qr/local/
spike/secure-qr/local/

node_modules/
dist/
build/
.vercel/
*.log
.DS_Store

# v1 leftovers. Removed from the tree, but older clones may still hold these
# files, including a private TEST key in tools/test-issuer/.keys/.
tools/test-issuer/.keys/
tools/test-issuer/out/
backend/
frontend/public/circuit/

# Downloaded on demand
frontend/public/bench/snarkjs.min.js
# Local demo: an ephemeral test issuer and synthetic QR images (apps/demo-rp/setup-demo.mjs)
apps/demo-rp/.demo/
# Hosted demo build (apps/demo-rp/vercel/build.mjs); holds that deployment's private TEST key
apps/demo-rp/.build/
# PAN prototype: circuit build, powers of tau, dev proving key (GBs); real records stay in local/
spike/pan/build/
spike/pan/local/
# Anon Aadhaar's circuit artifacts (fetch-artifacts.mjs) and setup-check downloads
packages/circuit/artifacts/
packages/circuit/setup/work/
